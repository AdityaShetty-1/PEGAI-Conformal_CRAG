# Choose one model endpoint. Defaults here use local Ollama.
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=llama3.2
LLM_API_KEY=ollama
EMBED_MODEL=ollama:all-minilm

# Alternative OpenAI-compatible provider. Keep credentials in this file only.
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.1-8b-instant
# LLM_API_KEY=your_groq_key
# LLM_MIN_INTERVAL=2
# EMBED_MODEL=BAAI/bge-small-en-v1.5

# OLLAMA_URL=http://127.0.0.1:11434
# TAVILY_API_KEY=your_tavily_key

# Streamlit settings. The CLI takes dataset and output from its flags.
DATASET=toy
CC_RESULTS=results_local
# USE_MOCK=1
